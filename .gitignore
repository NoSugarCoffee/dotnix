# --- Nix build outputs ---------------------------------------------------
# These are symlinks into /nix/store and must never be committed.
result
result-*
**/result
**/result-*

# --- Overlay marker ------------------------------------------------------
# Machine-local: names the private overlay flake that consumes this checkout,
# which makes `just switch` refuse to run from here. See the justfile.
.overlay

# --- Nix evaluation / direnv state ---------------------------------------
.direnv/
.envrc.local
.pre-commit-config.local.yaml

# --- Local secrets -------------------------------------------------------
secrets/
*.age
*.key
!*.pub

# --- Editor / OS noise ---------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Python bytecode -----------------------------------------------------
__pycache__/
*.py[cod]

# --- Misc ----------------------------------------------------------------
*.log
.cache/
node_modules/
